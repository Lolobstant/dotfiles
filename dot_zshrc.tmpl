# ─── fnm — Node version manager ───────────────────────────────────────────────
if command -v fnm &>/dev/null; then
  eval "$(fnm env --use-on-cd --shell zsh --version-file-strategy=recursive)"
fi
# ─── fnm end ──────────────────────────────────────────────────────────────────

#JJ
export JJ_EDITOR="nvim"

autoload -U add-zsh-hook

load-nvmrc() {
  local node_version="$(nvm version)"
  local nvmrc_path="$(nvm_find_nvmrc)"

  if [ -n "$nvmrc_path" ]; then
    local nvmrc_node_version=$(nvm version "$(cat "${nvmrc_path}")")

    if [ "$nvmrc_node_version" = "N/A" ]; then
      nvm install
    elif [ "$nvmrc_node_version" != "$node_version" ]; then
      nvm use
    fi
  elif [ "$node_version" != "$(nvm version default)" ]; then
    echo "Reverting to nvm default version"
    nvm use default
  fi
}

add-zsh-hook chpwd load-nvmrc
load-nvmrc
# NVM end

#Zinit
## set the directory we want to store zinit and plugins
export ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
ZINIT_COMMIT="5c0c0454deeb9eac95e08ef214b5d7ba6859db14"  # SHA immutable du commit de v3.14.0
ZINIT_TAG="v3.14.0"

if [ ! -d $ZINIT_HOME ]; then 
  mkdir -p "$(dirname $ZINIT_HOME)"
  git clone --branch "$ZINIT_TAG" --depth 1 https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
  # Vérification du commit SHA — protection contre un tag déplacé
  actual_commit=$(git -C "$ZINIT_HOME" rev-parse HEAD)
  if [ "$actual_commit" != "$ZINIT_COMMIT" ]; then
    echo "❌ zinit: commit SHA inattendu !" >&2
    echo "   attendu : $ZINIT_COMMIT" >&2
    echo "   obtenu  : $actual_commit" >&2
    echo "   → Possible compromission du tag $ZINIT_TAG" >&2
    rm -rf "$ZINIT_HOME"
    return 1
  fi
elif [ "$(git -C "$ZINIT_HOME" rev-parse HEAD 2>/dev/null)" != "$ZINIT_COMMIT" ]; then
  # Mauvaise version détectée (downgrade ou tag drifté) → refuser de charger
  echo "⚠️  zinit: version inattendue, attendu $ZINIT_TAG" >&2
  echo "   → Rerun: rm -rf $ZINIT_HOME && source ~/.zshrc" >&2
  return 1
fi
## load/source zinit
source "${ZINIT_HOME}/zinit.zsh"

# ─── Plugins ──────────────────────────────────────────────────────────────────
# Ordre strict :
#   1. zsh-completions  → doit alimenter fpath AVANT compinit
#   2. compinit
#   3. fzf-tab          → doit s'enregistrer APRÈS compinit
#   4. autosuggestions  → après compinit
#   5. syntax-highlight → TOUJOURS en dernier (hook sur ZLE)


# 1. Completions — blockf empêche le plugin de modifier fpath tout seul,
#    zinit le gère proprement via creinstall
zinit ice ver"0.36.0" blockf atpull"zinit creinstall -q ."
zinit light zsh-users/zsh-completions

# 2. compinit (avec cache — -C skip la vérif si le cache est frais)
autoload -U compinit
compinit -C
zinit cdreplay -q

# 3. fzf-tab — doit être chargé après compinit, avant syntax-highlighting
zinit ice ver"v1.3.0"
zinit light Aloxaf/fzf-tab

# 4. Autosuggestions
zinit ice ver"v0.7.1" atload"_zsh_autosuggest_start"
zinit light zsh-users/zsh-autosuggestions


# 5. Syntax highlighting — TOUJOURS EN DERNIER
#    S'il est chargé avant fzf-tab, les completions sont cassées
zinit ice ver"0.8.0"
zinit light zsh-users/zsh-syntax-highlighting

###zsh plugins from oh-my-zsh
zinit snippet OMZP::git
zinit snippet OMZP::eza

# jj completion — seulement si installé
command -v jj &>/dev/null && source <(jj util completion zsh)


### keybindings
bindkey '^y' autosuggest-accept
#### circle through history using previously written command as filter
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward

### history
HISTSIZE=5000
HISTFILE=~/.zsh_history
SAVEHIST=$HISTSIZE
HISTDUP=erase
HISTIGNORE="*TOKEN*:*SECRET*:*PASSWORD*:*API_KEY*:*PRIVATE*:*export *=*"
setopt appendhistory
setopt sharehistory
#### do not save command starting with a space to history
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_ignore_dups
setopt hist_find_no_dups

### completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
zstyle ':completion:*' list-colors '${(s.:.)LS_COLORS}'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza --icons=always --color=always --sort=type $realpath'
zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview 'eza --icons=always --color=always -sort=type $realpath'
zstyle ':omz:plugins:eza' 'dirs-first' yes
zstyle ':omz:plugins:eza' 'git-status' yes
zstyle ':omz:plugins:eza' 'icons' yes
zstyle ':omz:plugins:eza' 'time-style' iso

