# ─── Phase 7 : Git — config globale & hooks ───────────────────────────────────
step "Git — hooks globaux & config"

if cmd_exists git; then
  # core.hooksPath → ~/.githooks
  HOOKS_DIR="$HOME/.config/.githooks"
  if [[ -d "$HOOKS_DIR" ]]; then
    chmod +x "$HOOKS_DIR"/* 2>/dev/null || true
    current_hooks=$(git config --global core.hooksPath 2>/dev/null || echo "")
    if [[ "$current_hooks" != "$HOOKS_DIR" ]]; then
      $VERIFY_ONLY \
        && warn "core.hooksPath non configuré" \
        || { git config --global core.hooksPath "$HOOKS_DIR"; ok "core.hooksPath → $HOOKS_DIR"; }
    else
      ok "core.hooksPath → $HOOKS_DIR"
    fi
  else
    err "~/.githooks introuvable (chezmoi apply a-t-il tourné ?)"
  fi

  # excludesfile global
  GITIGNORE="$HOME/.config/.gitignore_global"
  if [[ -f "$GITIGNORE" ]]; then
    git config --global core.excludesfile "$GITIGNORE"
    ok "core.excludesfile → $GITIGNORE"
  fi

  # GPG signing
  gpgsign=$(git config --global commit.gpgsign 2>/dev/null || echo "")
  signing_key=$(git config --global user.signingkey 2>/dev/null || echo "")
  if [[ "$gpgsign" == "true" && -n "$signing_key" ]]; then
    ok "Commits signés GPG : $signing_key"
  else
    warn "GPG signing non configuré — commits non signés"
    warn "  → gpg --gen-key, puis ajouter la clé dans chezmoi keyring"
  fi

  # defaultBranch
  db=$(git config --global init.defaultBranch 2>/dev/null || echo "")
  [[ "$db" == "main" ]] \
    && ok "init.defaultBranch = main" \
    || { git config --global init.defaultBranch main; ok "init.defaultBranch → main"; }
fi

# ─── Phase 8 : Sécurité outils dev ───────────────────────────────────────────
step "Sécurité outils dev"

# npm — ignore-scripts
NPMRC="$HOME/.config/.npmrc"
if grep -q "ignore-scripts=true" "$NPMRC" 2>/dev/null; then
  ok "npm ignore-scripts=true"
else
  $VERIFY_ONLY \
    && warn "npm ignore-scripts non configuré (~/.npmrc)" \
    || { echo "ignore-scripts=true" >> "$NPMRC"; ok "npm ignore-scripts=true ajouté"; }
fi

# Claude Code sandbox
CLAUDE_SETTINGS="$HOME/.config/claude/settings.json"
if grep -q "denyRead" "$CLAUDE_SETTINGS" 2>/dev/null; then
  ok "Claude Code sandbox avec denyRead configuré"
else
  warn "Claude Code sandbox sans denyRead — risque exfiltration ~/.ssh"
fi

# Ollama — bind localhost only
if cmd_exists ollama; then
  ollama_host=$(launchctl asuser "$(id -u)" launchctl getenv OLLAMA_HOST 2>/dev/null || echo "")
  if [[ "$ollama_host" == *"0.0.0.0"* ]]; then
    warn "Ollama bind sur 0.0.0.0 — réduire à 127.0.0.1 via OLLAMA_HOST"
  else
    ok "Ollama : $(ollama --version 2>/dev/null | head -1)"
  fi
fi

# Apple Container
if cmd_exists container; then
  ok "Apple Container : $(container --version 2>/dev/null | head -1)"
else
  warn "Apple Container non installé — télécharger depuis github.com/apple/container"
fi

# fnm (NVM replacement)
if cmd_exists fnm; then
  ok "fnm $(fnm --version)"
elif cmd_exists nvm; then
  warn "NVM actif — migration disponible : brew install fnm"
fi

# ─── Rapport final ────────────────────────────────────────────────────────────
echo ""
echo -e "${BOLD}══════════════════════════════════════════════════${RESET}"
echo -e "${BOLD}  Bootstrap$(${VERIFY_ONLY} && echo ' — vérification seule')${RESET}"
echo -e "${BOLD}══════════════════════════════════════════════════${RESET}"

if [[ ${#ERRORS[@]} -eq 0 && ${#WARNINGS[@]} -eq 0 ]]; then
  echo -e "\n${GREEN}${BOLD}✓ Tout est en ordre.${RESET}\n"
else
  [[ ${#ERRORS[@]} -gt 0 ]] && {
    echo -e "\n${RED}${BOLD}Erreurs (${#ERRORS[@]}) :${RESET}"
    for e in "${ERRORS[@]}"; do echo -e "  ${RED}✗${RESET} $e"; done
  }
  [[ ${#WARNINGS[@]} -gt 0 ]] && {
    echo -e "\n${YELLOW}${BOLD}Avertissements (${#WARNINGS[@]}) :${RESET}"
    for w in "${WARNINGS[@]}"; do echo -e "  ${YELLOW}⚠${RESET}  $w"; done
  }
fi

echo -e "\n${BOLD}Étapes manuelles restantes :${RESET} voir MANUAL_STEPS.md\n"

[[ ${#ERRORS[@]} -gt 0 ]] && exit 1 || exit 0
