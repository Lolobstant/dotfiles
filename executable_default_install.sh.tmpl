#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# default_install.sh — bootstrap idempotent macOS 26
# Usage : ./default_install.sh [--verify-only] [--skip-brew] [--skip-dns]
#
# Idempotent : sûr à relancer, vérifie avant d'agir.
# Chezmoi template — utilise {{ .github.username }}, {{ .email }}, {{ .name }}
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

# ─── Args ─────────────────────────────────────────────────────────────────────
VERIFY_ONLY=false
SKIP_BREW=false
SKIP_DNS=false
for arg in "$@"; do
  case $arg in
    --verify-only) VERIFY_ONLY=true ;;
    --skip-brew)   SKIP_BREW=true ;;
    --skip-dns)    SKIP_DNS=true ;;
  esac
done

# ─── Helpers ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'; YELLOW='\033[1;33m'; GREEN='\033[0;32m'
BLUE='\033[0;34m'; BOLD='\033[1m'; RESET='\033[0m'

ERRORS=(); WARNINGS=()

log()   { echo -e "${BLUE}▶${RESET} $*"; }
ok()    { echo -e "${GREEN}✓${RESET} $*"; }
warn()  { echo -e "${YELLOW}⚠${RESET}  $*"; WARNINGS+=("$*"); }
err()   { echo -e "${RED}✗${RESET} $*" >&2; ERRORS+=("$*"); }
step()  { echo -e "\n${BOLD}── $* ──${RESET}"; }

cmd_exists() { command -v "$1" &>/dev/null; }

# Charger brew dans le PATH si besoin (script lancé hors shell interactif)
[[ -f /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"

# ─── Phase 0 : Vérifications système ─────────────────────────────────────────
step "Vérifications système"

[[ "$(uname -s)" == "Darwin" ]] || { err "macOS requis"; exit 1; }
[[ "$(uname -m)" == "arm64"  ]] || warn "Apple Silicon requis pour Apple Container + Ollama MLX"

os_ver=$(sw_vers -productVersion)
ok "macOS $os_ver ($(uname -m))"

# ─── Phase 1 : Homebrew ───────────────────────────────────────────────────────
step "Homebrew"

if ! cmd_exists brew; then
  if $VERIFY_ONLY; then
    err "Homebrew non installé"
  else
    log "Installation Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
fi

if cmd_exists brew; then
  brew analytics off
  ok "Homebrew $(brew --version | head -1 | awk '{print $2}') — analytics off"
fi

# ─── Phase 2 : chezmoi + dotfiles ────────────────────────────────────────────
step "chezmoi — dotfiles"

if ! cmd_exists chezmoi; then
  $VERIFY_ONLY && err "chezmoi non installé" || brew install chezmoi
fi

if cmd_exists chezmoi && ! $VERIFY_ONLY; then
  chezmoi_source=$(chezmoi source-path 2>/dev/null || echo "")
  if [[ -z "$chezmoi_source" || ! -d "$chezmoi_source" ]]; then
    log "Initialisation chezmoi depuis GitHub..."
    # HTTPS pour le bootstrap — pas de SSH key nécessaire
    chezmoi init --apply "https://github.com/{{ .github.username }}/dotfiles.git"
  else
    log "chezmoi apply (dotfiles déjà initialisés)..."
    chezmoi apply --no-tty 2>/dev/null || chezmoi apply
  fi
  ok "chezmoi apply"
fi

# ─── Phase 3 : Brewfile ───────────────────────────────────────────────────────
step "Packages Homebrew"

BREWFILE="${HOMEBREW_BUNDLE_FILE:-$HOME/.config/homebrew/config.homebrew}"

if [[ ! -f "$BREWFILE" ]]; then
  err "Brewfile introuvable : $BREWFILE"
elif ! $SKIP_BREW; then
  if $VERIFY_ONLY; then
    brew bundle check --file="$BREWFILE" --quiet 2>/dev/null \
      && ok "Tous les packages Brewfile présents" \
      || warn "Certains packages Brewfile manquent"
  else
    log "brew bundle install --no-upgrade..."
    brew bundle install --no-upgrade --file="$BREWFILE" --quiet
    ok "Brewfile appliqué"
  fi
fi

# ─── Phase 4 : macOS defaults & durcissement ─────────────────────────────────
step "macOS defaults & sécurité"

_defaults_write() {
  local domain=$1 key=$2 type=$3 val=$4
  current=$(defaults read "$domain" "$key" 2>/dev/null || echo "__unset__")
  if [[ "$current" != "$val" ]]; then
    $VERIFY_ONLY \
      && warn "defaults $domain $key = $current (attendu : $val)" \
      || { defaults write "$domain" "$key" "$type" "$val"; ok "$key = $val"; }
  else
    ok "$key = $val"
  fi
}

# Police — anticrénelage
_defaults_write "-g"                              AppleFontSmoothing    -int  0
# Écran verrouillé dès la mise en veille
_defaults_write com.apple.screensaver            askForPassword        -int  1
_defaults_write com.apple.screensaver            askForPasswordDelay   -int  0
# AirDrop — Contacts seulement (pas "Tout le monde")
_defaults_write com.apple.NetworkBrowser         DisableAirDrop        -bool false
_defaults_write com.apple.sharingd               AirDropComeBack       -bool false

# ─── Phase 5 : Firewall & accès distants ──────────────────────────────────────
step "Firewall & accès distants"

# Firewall applicatif + mode furtif
fw_on=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null)
if echo "$fw_on" | grep -q "enabled"; then
  ok "Firewall applicatif actif"
else
  $VERIFY_ONLY \
    && err "Firewall désactivé" \
    || { sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setglobalstate on; ok "Firewall activé"; }
fi

stealth=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getstealthmode 2>/dev/null)
if echo "$stealth" | grep -q "enabled"; then
  ok "Mode furtif actif"
else
  $VERIFY_ONLY \
    && warn "Mode furtif désactivé" \
    || { sudo /usr/libexec/ApplicationFirewall/socketfilterfw --setstealthmode on; ok "Mode furtif activé"; }
fi

# Remote login (SSH entrant) — désactivé
# systemsetup -setremotelogin déprécié macOS 13+, on utilise launchctl
if sudo launchctl list com.openssh.sshd &>/dev/null 2>&1; then
  $VERIFY_ONLY \
    && warn "SSH entrant actif (com.openssh.sshd)" \
    || { sudo launchctl disable system/com.openssh.sshd 2>/dev/null || true; ok "SSH entrant désactivé"; }
else
  ok "SSH entrant désactivé"
fi

# FileVault
fv=$(fdesetup status 2>/dev/null | head -1)
if echo "$fv" | grep -q "On"; then
  ok "FileVault activé"
else
  err "FileVault DÉSACTIVÉ — CRITIQUE. Paramètres → Confidentialité → FileVault"
fi

# SIP
sip=$(csrutil status 2>/dev/null)
echo "$sip" | grep -q "enabled" && ok "SIP activé" || warn "SIP : $sip"

