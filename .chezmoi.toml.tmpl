{{- $email := promptString "email" -}}
{{- $github_username := promptString "github username" -}}
{{- $infisical_token := promptString "infisical token" -}}

[edit]
  command = "nvim"
[data]
  email = {{ $email | quote }}
[data.github]
  username = {{ $github_username | quote }}
[data.infisical]
  token = {{ $infisical_token | quote }}
[add]
  secrets = "error"
[git]
  autoCommit=true
  autoPush=true
