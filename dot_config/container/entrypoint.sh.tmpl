#!/bin/bash
set -eo pipefail

# Bootstrap dotfiles via chezmoi — seulement si pas encore initialisé
if [ -n "${DOTFILES_REPO:-}" ]; then
  if [ ! -d "$HOME/.local/share/chezmoi" ]; then
    echo "⚡ Bootstrap dotfiles depuis ${DOTFILES_REPO}"
      chezmoi init --apply \
        --promptString "email={{ .email }}" \
        --promptString "github_username={{ .github.username }}" \
        --promptString "infisical_token={{ .infisical.token }}" \
        "${DOTFILES_REPO}"
  else
    echo "⚡ Dotfiles déjà initialisés, skip"
  fi
fi

# Si dotfiles bootstrappés, pré-installer les plugins Lazy
if [ -d "$HOME/.config/nvim" ]; then
  echo "⚡ Installation plugins Lazy.nvim..."
  nvim --headless "+Lazy! sync" +qa 2>/dev/null || true
  echo "✅ Plugins OK"
fi

exec "$@"
