#!/bin/bash
set -eo pipefail

# Usage: dev.sh <nom-projet>
PROJECT=${1:?Usage: dev.sh <nom-projet>}

IMAGE="ghcr.io/test/dev-base:1.0.0"
SOCKET_DIR="/tmp/nvim-sockets"
SOCKET_NAME="nvim-${PROJECT}.sock"
SOCKET="$SOCKET_DIR/$SOCKET_NAME"

# Cleanup à la sortie (erreur ou normale)
cleanup() {
  local exit_code=$?
  if [ $exit_code -ne 0 ]; then
    echo "❌ Erreur (code $exit_code) — nettoyage..."
  else
    echo "🛑 Fermeture du container..."
  fi
  container stop "dev-${PROJECT}" 2>/dev/null || true
  rm -f "$SOCKET" 2>/dev/null || true
  exit $exit_code
}
trap cleanup EXIT

# Répertoire partagé pour les sockets Unix
mkdir -p "$SOCKET_DIR"

# Token Infisical depuis le Keychain (optionnel — pas encore configuré)
INFISICAL_TOKEN="{{ .infisical.token }}"
if security find-generic-password -a infisical -s dev -w &>/dev/null 2>&1; then
  INFISICAL_TOKEN=$(security find-generic-password -a infisical -s dev -w)
fi

echo "⚡ Démarrage container : $PROJECT"

echo "   Neovide  : neovide --server $SOCKET"

# Construire les args dynamiquement
EXTRA_ENV=()
[ -n "$INFISICAL_TOKEN" ] && EXTRA_ENV+=(-e "INFISICAL_TOKEN=$INFISICAL_TOKEN")

container run --rm --detach \
  --name "dev-${PROJECT}" \
  -e CHEZMOI_EMAIL="{{ .email }}" \
  -e CHEZMOI_GITHUB_USERNAME="{{ .github.username }}" \
  -e CHEZMOI_INFISICAL_TOKEN="${INFISICAL_TOKEN:-to-be-configured}" \
 "${EXTRA_ENV[@]}" \
  -v "$(pwd):/app" \
  -v "$SOCKET_DIR:$SOCKET_DIR" \
  --publish-socket "${SOCKET}:/tmp/nvim.sock" \
  -w /app \
  "$IMAGE" \
  nvim --headless --listen "/tmp/nvim.sock"

# Attendre que la socket soit créée (max 30s)
echo "⏳ Attente du socket nvim..."
TIMEOUT=120
ELAPSED=0
until container exec "dev-${PROJECT}" \
  nvim --server /tmp/nvim.sock --remote-expr '"ready"' 2>/dev/null | grep -q "ready"; do
  sleep 1
  ELAPSED=$((ELAPSED + 1))
  if [ "$ELAPSED" -ge "$TIMEOUT" ]; then
    echo "❌ Timeout — nvim n'a pas répondu"
    container stop "dev-${PROJECT}" 2>/dev/null || true
    # kill "$CONTAINER_PID" 2>/dev/null || true
    exit 1
  fi
done

if [ ! -S "$SOCKET" ]; then
  echo "❌ Timeout — nvim n'a pas démarré"
  # kill $CONTAINER_PID 2>/dev/null
  container logs "dev-${PROJECT}"
  exit 1
fi

echo "✅ Socket prêt — lancement Neovide"
neovide --server "$SOCKET"
