#!/bin/bash
set -euo pipefail

# Usage: dev.sh <nom-projet>
PROJECT=${1:?Usage: dev.sh <nom-projet>}

IMAGE="ghcr.io/test/dev-base:1.0.0"
SOCKET_DIR="/tmp/nvim-sockets"
SOCKET="$SOCKET_DIR/nvim-${PROJECT}.sock"

# Répertoire partagé pour les sockets Unix
mkdir -p "$SOCKET_DIR"

# Token Infisical depuis le Keychain (optionnel — pas encore configuré)
INFISICAL_TOKEN="{{ .infisical.token }}"
if security find-generic-password -a infisical -s dev -w &>/dev/null 2>&1; then
  INFISICAL_TOKEN=$(security find-generic-password -a infisical -s dev -w)
fi

echo "⚡ Démarrage container : $PROJECT"

echo "   Neovide  : neovide --server $SOCKET"

container run --rm --detach \
  --name "dev-${PROJECT}" \
  -e CHEZMOI_EMAIL="{{ .email }}" \
  -e CHEZMOI_GITHUB_USERNAME="{{ .github.username }}" \
  -e CHEZMOI_INFISICAL_TOKEN="$INFISICAL_TOKEN" \
  ${INFISICAL_TOKEN:+-e INFISICAL_TOKEN="$INFISICAL_TOKEN"} \
  -v "$(pwd):/app" \
  -v "$SOCKET_DIR:/tmp/nvim-sockets" \
  -w /app \
  "$IMAGE" \
  nvim --headless --listen "/tmp/nvim-sockets/nvim-${PROJECT}.sock"

CONTAINER_PID=$!

# Attendre que la socket soit créée (max 30s)
echo "⏳ Attente du socket nvim..."
TIMEOUT=60
ELAPSED=0
until [ -S "$SOCKET" ] || [ $ELAPSED -ge $TIMEOUT ]; do
  sleep 0.5
  ELAPSED=$((ELAPSED + 1))
done

if [ ! -S "$SOCKET" ]; then
  echo "❌ Timeout — nvim n'a pas démarré"
  kill $CONTAINER_PID 2>/dev/null
  # container logs "dev-${PROJECT}"
  exit 1
fi

echo "✅ Socket prêt — lancement Neovide"
neovide --server "$SOCKET"

# Quand Neovide se ferme, arrêter le container
echo "🛑 Fermeture du container..."
container stop "dev-${PROJECT}" 2>/dev/null || true
wait $CONTAINER_PID 2>/dev/null || true
